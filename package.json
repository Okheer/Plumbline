{
  "name": "plumbline",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @plumbline/backend --filter @plumbline/frontend dev",
    "check": "pnpm -r typecheck && pnpm test && pnpm integration:check",
    "test": "tsx --test packages/shared/test/*.test.ts",
    "build": "pnpm --filter @plumbline/frontend build",
    "integration:check": "tsx scripts/check-integrations.ts",
    "proto:check": "buf lint packages/oracle/proto",
    "identity:preflight": "tsx packages/backend/src/identity/preflight.ts",
    "identity:plan": "tsx scripts/identity-plan.ts",
    "identity:test": "python3 scripts/test-identity-fork.py",
    "identity:quote": "tsx scripts/identity-quote.ts",
    "identity:register": "tsx scripts/identity-metamask.ts",
    "identity:verify": "tsx scripts/verify-identity.ts",
    "identity:mint": "tsx scripts/identity-metamask.ts",
    "identity:receipt-test": "tsx scripts/test-receipt-match.ts",
    "authority:test": "python3 scripts/test-identity-fork.py --authority",
    "authority:verify": "tsx scripts/verify-phase3.ts",
    "authority:prepare-demo": "tsx scripts/prepare-mandate-demo.ts",
    "authority:sign-demo": "tsx scripts/identity-metamask.ts --demo"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.13",
    "@types/node": "22.20.2",
    "@bufbuild/buf": "1.73.0",
    "@1inch/aqua-sdk": "0.3.4",
    "@1inch/swap-vm-sdk": "0.4.4",
    "@ensdomains/ensjs": "4.3.1",
    "viem": "2.56.3"
  },
  "type": "module"
}
